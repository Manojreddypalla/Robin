# ============================================================
# Robin 2.0 — Environment Config (Example)
# ============================================================

# --- 👤 USER IDENTITY ---
USER_ID=your_id
USER_NAME=your_name
USER_COLLEGE=your_college
USER_GRAD_YEAR=your_year
USER_INTERESTS=AI/ML, RAG, LLM agents
USER_VISION=your_vision
USER_STACK=your_stack

# --- 🤖 ROBIN PERSONALITY ---
ROBIN_NAME=Robin
ROBIN_ROLE=AI agent
ROBIN_PERSONALITY=Direct and helpful
ROBIN_MENTOR_AREAS=AI/ML, Systems

# --- 🔑 API KEYS ---
GEMINI_KEYS=your_api_keys_here
NEWS_API_KEY=your_news_api_key_here

# --- 🏗️ INFRASTRUCTURE ---
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
MONGO_URI=mongodb://username:password@localhost:27017/?authSource=admin

# --- 📂 COLLECTIONS ---
REPO_COLLECTION=repo_collection
BOOK_COLLECTION=book_collection
MEM_COLLECTION=memory_collection

# --- 🗄️ NEO4J ---
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# --- 🧠 MODELS ---
ROUTER_MODEL=qwen2.5:7b
REWRITE_MODEL=qwen2.5:7b
LOCAL_ORACLE_MODEL=llama3.1:8b
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=nomic-embed-text
MEMORY_LLM_MODEL=qwen2.5:7b